# ========================================================
# CALYVIA WELLNESS CENTER MANAGEMENT SYSTEM CONFIGURATION
# Production & Local Development Environment Variables Template
# ========================================================

# General Environment & Ports
NODE_ENV=development
PORT=4000
ADMIN_PORT=3000
APP_NAME="Calyvia Wellness Center Management System"
API_URL=http://localhost:4000/api/v1
ADMIN_URL=http://localhost:3000

# Kenya Locale & Timezone
TZ=Africa/Nairobi
DEFAULT_CURRENCY=KES
COUNTRY_CODE=+254

# Supabase Project Configuration (Sole Hosted Backend)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_REST_URL=https://[PROJECT-REF].supabase.co/rest/v1/
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Supabase PostgreSQL Database (Transaction Pooler: 6543, Direct: 5432)
# Password must be URL-encoded (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL_ENCODED_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[URL_ENCODED_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_PASSWORD="[YOUR-DATABASE-PASSWORD]"

# Local docker-compose credentials. Set real values in the deployment environment.
POSTGRES_USER="replace_with_postgres_user"
POSTGRES_PASSWORD="replace_with_postgres_password"
POSTGRES_DB="calyvia_db"
MINIO_ROOT_USER="replace_with_minio_user"
MINIO_ROOT_PASSWORD="replace_with_minio_password"

# Redis Cache & BullMQ (Optional background queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Field-Level Encryption Master Key (AES-256-GCM - exactly 32 bytes hex = 64 hex characters)
ENCRYPTION_MASTER_KEY="replace_with_64_hex_characters_in_deployment_environment"

# Safaricom M-Pesa Daraja Configuration (set these only in the API environment)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="replace_with_consumer_key"
MPESA_CONSUMER_SECRET="replace_with_consumer_secret"
MPESA_SHORTCODE="replace_with_paybill_or_till"
MPESA_PASSKEY="replace_with_passkey"
MPESA_CALLBACK_URL="https://api.calyviawellness.co.ke/api/v1/integrations/mpesa/callback"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Optional: comma-separated Safaricom callback IPs from your Daraja portal.
MPESA_CALLBACK_ALLOWED_IPS=""

# ========================================================
# Communication Gateways (SMS & WhatsApp)
# ========================================================

# --- SMS ---
# Production SMS gateway. The mock driver is only available locally/in tests and
# is ignored in production, even if an old deployment still sets SMS_PROVIDER=mock.
SMS_PROVIDER=bytewave

# ByteWave Networks (https://portal.bytewavenetworks.com) - primary Kenyan gateway.
# Two APIs (see portal API / Developers menu):
#   HTTP    https://portal.bytewavenetworks.com/api/http/  (simple key)
#   OAuth2  https://portal.bytewavenetworks.com/api/v3/     (client credentials -> Bearer)
# BYTEWAVE_API_MODE: http | oauth2 (default http). For oauth2 you may paste the
# combined oc_sk_<clientId>_<clientSecret> value as BYTEWAVE_API_KEY and leave
# BYTEWAVE_CLIENT_ID / BYTEWAVE_CLIENT_SECRET empty - the driver splits it.
BYTEWAVE_API_MODE=http
BYTEWAVE_API_URL=""
BYTEWAVE_API_KEY=""
BYTEWAVE_CLIENT_ID=""
BYTEWAVE_CLIENT_SECRET=""
BYTEWAVE_SENDER_ID="BytewaveSMS"
# Price per SMS segment. ByteWave's balance API reports only KES credit, so this
# rate is used for the "SMS available" estimate (and cost logging).
BYTEWAVE_SMS_COST_KES=0.25
# HTTP mode calls GET /api/http/sms/send?api_token=…&recipient=…&message=…&sender_id=…
# Field names are fixed by the portal; the old BYTEWAVE_PARAM_* variables are ignored.
# Response field carrying the gateway message id
BYTEWAVE_ID_FIELD=id

# --- WhatsApp (Baileys - UNOFFICIAL client) ---
# Options: baileys (the mock driver is dev/test only)
# WARNING: Baileys is an unofficial WhatsApp Web client and violates WhatsApp's ToS
# for automated messaging. The linked number CAN BE BANNED. Read
# docs/runbooks/whatsapp-ban-risk.md before setting this to "baileys".
WHATSAPP_PROVIDER=baileys
# Where the login session is persisted. Must survive restarts or you re-pair every deploy.
BAILEYS_AUTH_DIR=.baileys-auth
# Leave BOTH unset. Baileys uses the protocol revision bundled with the installed
# package. Only opt in deliberately when upgrading the Baileys dependency too.
# BAILEYS_USE_LATEST_VERSION=true
# BAILEYS_CLIENT_VERSION=2.3000.1043857760

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_FIELD_ENCRYPTION=true
ENABLE_AI_EXTENSIONS=false

# ========================================================
# Frontend (Next.js Admin / Netlify) Environment Variables
# ========================================================
NEXT_PUBLIC_API_URL="https://api.calyviawellness.co.ke/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_publishable_key_here"
